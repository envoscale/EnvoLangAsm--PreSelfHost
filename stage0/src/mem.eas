; =============================================================================
; src/mem.eas - arena allocator and small memory helpers
;
; Stage 0 is a short-lived batch process, so memory is never freed: one bump
; pointer over 64 MiB chunks from sys_alloc. Chunks come zeroed from the OS, so
; every allocation is zeroed. A request bigger than a chunk gets its own mapping.
; =============================================================================

ARENA_CHUNK     equ 0x4000000           ; 64 MiB

; arena_alloc - allocate zeroed memory, 16-byte aligned. Exits on out-of-memory.
;   in:  rdi = size in bytes
;   out: rax = pointer
;   clobbers: rcx, rdx, rsi, rdi, r8-r11
arena_alloc:
        add     rdi, 15
        and     rdi, -16
        mov     rax, [arena_cur]
        mov     rdx, [arena_end]
        sub     rdx, rax                ; bytes left in the current chunk
        cmp     rdi, rdx
        ja      short .grow
        add     rdi, rax
        mov     [arena_cur], rdi
        ret
.grow:
        push    rbx
        push    r12
        sub     rsp, 8                  ; keep rsp aligned for the call below
        mov     rbx, rdi                ; rbx = request size
        mov     r12, ARENA_CHUNK        ; r12 = size of the new mapping
        cmp     rbx, r12
        jbe     short .map
        lea     r12, [rbx + 0xFFF]      ; oversized request: round up to pages
        and     r12, -0x1000
.map:
        mov     rdi, r12
        call    sys_alloc
        test    rax, rax
        jz      short .oom
        ; The rest of the old chunk is abandoned; simpler than tracking two chunks.
        lea     rdx, [rax + rbx]
        mov     [arena_cur], rdx
        lea     rdx, [rax + r12]
        mov     [arena_end], rdx
        add     rsp, 8
        pop     r12
        pop     rbx
        ret
.oom:
        lea     rdi, [msg_oom]
        mov     esi, msg_oom_len
        jmp     near fatal

; mem_eq - compare two byte ranges of the same length.
;   in:  rdi = a, rsi = b, rdx = length
;   out: eax = 1 if equal, else 0.  clobbers: rcx
mem_eq:
        xor     ecx, ecx
.loop:
        cmp     rcx, rdx
        jae     short .equal
        movzx   eax, byte [rdi + rcx]
        cmp     al, [rsi + rcx]
        jne     short .differ
        inc     rcx
        jmp     short .loop
.equal:
        mov     eax, 1
        ret
.differ:
        xor     eax, eax
        ret

; cstr_len - length of a NUL-terminated string.
;   in:  rdi = string
;   out: rax = length (excluding the NUL)
cstr_len:
        xor     eax, eax
.loop:
        cmp     byte [rdi + rax], 0
        je      short .done
        inc     rax
        jmp     short .loop
.done:
        ret

; cstr_eq - compare a NUL-terminated string with a (pointer, length) string.
;   in:  rdi = NUL-terminated string, rsi = other string, rdx = its length
;   out: eax = 1 if equal, else 0.  clobbers: rcx
cstr_eq:
        xor     ecx, ecx
.loop:
        cmp     rcx, rdx
        jae     short .end
        movzx   eax, byte [rdi + rcx]
        test    al, al                  ; NUL before the end: shorter, so different
        jz      short .differ
        cmp     al, [rsi + rcx]
        jne     short .differ
        inc     rcx
        jmp     short .loop
.end:
        cmp     byte [rdi + rcx], 0     ; equal only if the C string ends here too
        jne     short .differ
        mov     eax, 1
        ret
.differ:
        xor     eax, eax
        ret

msg_oom:        db 'out of memory'
msg_oom_len     equ $ - msg_oom

        align   8, db 0
arena_cur:      dq 0
arena_end:      dq 0
