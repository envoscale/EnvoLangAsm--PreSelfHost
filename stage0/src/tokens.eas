        db      2, '-%'                 ;  93 TK_WRAP_SUB
        align   16, db 0
        db      2, '*%'                 ;  94 TK_WRAP_MUL
        align   16, db 0
        db      1, '+'                  ;  95 TK_PLUS
        align   16, db 0
        db      1, '-'                  ;  96 TK_MINUS
        align   16, db 0
        db      1, '*'                  ;  97 TK_STAR
        align   16, db 0
        db      1, '/'                  ;  98 TK_SLASH
        align   16, db 0
