        align   16, db 0

; Numeric literal suffixes ([lex.int.3], [lex.float.3]). 8-byte entries:
; length byte, spelling. Entries before SUFFIX_FLOAT_FIRST are integer suffixes.
SUFFIX_COUNT        equ 14
SUFFIX_FLOAT_FIRST  equ 12
        align   8, db 0
suffix_table:
        db      2, 'i8'
        align   8, db 0
        db      3, 'i16'
        align   8, db 0
        db      3, 'i32'
        align   8, db 0
        db      3, 'i64'
        align   8, db 0
        db      4, 'i128'
        align   8, db 0
        db      5, 'isize'
        align   8, db 0
        db      2, 'u8'
        align   8, db 0
        db      3, 'u16'
        align   8, db 0
        db      3, 'u32'
        align   8, db 0
        db      3, 'u64'
        align   8, db 0
        db      4, 'u128'
        align   8, db 0
        db      5, 'usize'
        align   8, db 0
        db      3, 'f32'
        align   8, db 0
        db      3, 'f64'
        align   8, db 0

