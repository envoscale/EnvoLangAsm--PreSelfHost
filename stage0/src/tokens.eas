; =============================================================================
; src/tokens.eas - token kinds and the kind table
;
; Kind numbers are positions in tok_table. Ranges:
;   literals/ident  TK_EOF .. TK_STRING
;   keywords        TK_KW_FIRST .. TK_KW_LAST   (docs/spec/01-lexical.md 1.6.1)
;   punctuation     TK_PUNCT_FIRST .. TK_PUNCT_LAST, ordered longest spelling
;                   first, so the first match while scanning is the maximal
;                   munch ([lex.punct.1])
;
; Each tok_table entry is 16 bytes: a length byte, then the spelling (keywords
; and punctuation) or the class name used by the token dump (literals).
; Adding a kind means adding an equ AND a table row at the same position.
;
; Token records produced by the lexer are 16 bytes:
;   +0 u16 kind, +2 u16 flags, +4 u32 start offset, +8 u32 length, +12 u32 line
; =============================================================================

TOK_KIND        equ 0
TOK_FLAGS       equ 2
TOK_START       equ 4
TOK_LEN         equ 8
TOK_LINE        equ 12
TOK_SIZE        equ 16

TF_SPACE_BEFORE   equ 1                 ; [lex.flags.1]
TF_NEWLINE_BEFORE equ 2                 ; [lex.flags.2]

TK_EOF              equ 0
TK_IDENT            equ 1
TK_INT              equ 2
TK_FLOAT            equ 3
TK_CHAR             equ 4
TK_STRING           equ 5
TK_KW_UNDERSCORE    equ 6
TK_KW_ABSTRACT      equ 7
TK_KW_ALIGNOF       equ 8
TK_KW_AS            equ 9
TK_KW_ASM           equ 10
TK_KW_ASYNC         equ 11
TK_KW_AWAIT         equ 12
TK_KW_BASE          equ 13
TK_KW_BREAK         equ 14
TK_KW_CATCH         equ 15
TK_KW_CLASS         equ 16
TK_KW_COMPTIME      equ 17
TK_KW_CONST         equ 18
TK_KW_CONTINUE      equ 19
TK_KW_DO            equ 20
TK_KW_ELSE          equ 21
TK_KW_ENUM          equ 22
TK_KW_EXTERN        equ 23
TK_KW_FALSE         equ 24
TK_KW_FOR           equ 25
TK_KW_FOREACH       equ 26
TK_KW_GOTO          equ 27
TK_KW_IF            equ 28
TK_KW_IMPL          equ 29
TK_KW_IN            equ 30
TK_KW_INTERFACE     equ 31
TK_KW_INTERNAL      equ 32
TK_KW_MACRO         equ 33
TK_KW_MATCH         equ 34
TK_KW_NAMESPACE     equ 35
TK_KW_NEW           equ 36
TK_KW_NULL          equ 37
TK_KW_OUT           equ 38
TK_KW_OVERRIDE      equ 39
TK_KW_PRIVATE       equ 40
TK_KW_PROTECTED     equ 41
TK_KW_PUBLIC        equ 42
TK_KW_REF           equ 43
TK_KW_RETURN        equ 44
TK_KW_SEALED        equ 45
TK_KW_SIZEOF        equ 46
TK_KW_STATIC        equ 47
TK_KW_STRUCT        equ 48
TK_KW_THIS          equ 49
TK_KW_THROW         equ 50
TK_KW_TRUE          equ 51
TK_KW_TRY           equ 52
TK_KW_UNSAFE        equ 53
TK_KW_USE           equ 54
TK_KW_USING         equ 55
TK_KW_VAR           equ 56
TK_KW_VIRTUAL       equ 57
TK_KW_WEAK          equ 58
TK_KW_WHERE         equ 59
TK_KW_WHILE         equ 60
TK_KW_YIELD         equ 61
TK_SHL_EQ           equ 62
TK_SHR_EQ           equ 63
TK_DOT_DOT_EQ       equ 64
TK_QQ_EQ            equ 65
TK_WRAP_ADD_EQ      equ 66
TK_WRAP_SUB_EQ      equ 67
TK_WRAP_MUL_EQ      equ 68
TK_EQ_EQ            equ 69
TK_NOT_EQ           equ 70
TK_LT_EQ            equ 71
TK_GT_EQ            equ 72
TK_AND_AND          equ 73
TK_OR_OR            equ 74
TK_SHL              equ 75
TK_SHR              equ 76
TK_PLUS_EQ          equ 77
TK_MINUS_EQ         equ 78
TK_STAR_EQ          equ 79
TK_SLASH_EQ         equ 80
TK_PERCENT_EQ       equ 81
TK_AMP_EQ           equ 82
TK_PIPE_EQ          equ 83
TK_CARET_EQ         equ 84
TK_FAT_ARROW        equ 85
TK_ARROW            equ 86
TK_COLON_COLON      equ 87
TK_DOT_DOT          equ 88
TK_QQ               equ 89
TK_PLUS_PLUS        equ 90
TK_MINUS_MINUS      equ 91
TK_WRAP_ADD         equ 92
TK_WRAP_SUB         equ 93
TK_WRAP_MUL         equ 94
TK_PLUS             equ 95
TK_MINUS            equ 96
TK_STAR             equ 97
TK_SLASH            equ 98
TK_PERCENT          equ 99
TK_EQ               equ 100
TK_LT               equ 101
TK_GT               equ 102
TK_BANG             equ 103
TK_TILDE            equ 104
TK_AMP              equ 105
TK_PIPE             equ 106
TK_CARET            equ 107
TK_QUESTION         equ 108
TK_COLON            equ 109
TK_SEMI             equ 110
TK_COMMA            equ 111
TK_DOT              equ 112
TK_LPAREN           equ 113
TK_RPAREN           equ 114
TK_LBRACKET         equ 115
TK_RBRACKET         equ 116
TK_LBRACE           equ 117
TK_RBRACE           equ 118

TK_KW_FIRST         equ 6
TK_KW_LAST          equ 61
TK_PUNCT_FIRST      equ 62
TK_PUNCT_LAST       equ 118
TK_COUNT            equ 119

        align   16, db 0
tok_table:
        db      3, 'eof'                ;   0 TK_EOF
        align   16, db 0
        db      5, 'ident'              ;   1 TK_IDENT
        align   16, db 0
        db      3, 'int'                ;   2 TK_INT
        align   16, db 0
        db      5, 'float'              ;   3 TK_FLOAT
        align   16, db 0
        db      4, 'char'               ;   4 TK_CHAR
        align   16, db 0
        db      6, 'string'             ;   5 TK_STRING
        align   16, db 0
        db      1, '_'                  ;   6 TK_KW_UNDERSCORE
        align   16, db 0
        db      8, 'abstract'           ;   7 TK_KW_ABSTRACT
        align   16, db 0
        db      7, 'alignof'            ;   8 TK_KW_ALIGNOF
        align   16, db 0
