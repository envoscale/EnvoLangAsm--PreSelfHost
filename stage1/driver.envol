// Commands: loading source files and running the compiler's passes, with the same
// messages and exit codes as envoc0 (envo-core.md section 7).

const usize MAX_SOURCE = 16 << 20;     // 16 MiB per file, as in Stage 0

// Reads every path given on the command line, in order, and adds it to the source file
// table. Reports the first file that cannot be read, as envoc0 does, and exits.
void LoadSources(usize first, usize count) {
    for (usize i = 0; i < count; i++) {
        str path = arg(first + i);
        Buf text = BufNew(0);
        bool ok;
        unsafe { ok = FileRead(path, &text); }
        if (!ok) {
            *Buf e = Err();
            BufStr(e, "envoc1: error: cannot open '");
            BufStr(e, path);
            BufStr(e, "'\n");
            Exit(EXIT_ERRORS);
        }
        if (text.Len > MAX_SOURCE) {
            *Buf e = Err();
            BufStr(e, "envoc1: error: file too large: '");
            BufStr(e, path);
            BufStr(e, "' (Stage 1 accepts source files up to 16 MiB)\n");
            Exit(EXIT_ERRORS);
        }
        unsafe { SrcAdd(path, BufView(&text)); }
    }
}

// `envoc1 lex <file.envol>`
void CmdLex(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        Exit(EXIT_USAGE);
    }
    LoadSources(argi, 1);
    Vec toks = VecNew(sizeof(Token), 1024);
    unsafe {
        Lex(0, &toks, core);
        LexDump(&toks);
    }
    Exit(EXIT_OK);
}

// Lexes every loaded source file into toks, recording each file's first token in starts.
void LexAll(*Vec toks, *Vec starts, bool core) {
    usize files = VecLen(Files());
    for (usize f = 0; f < files; f++) {
        VecPushU64(starts, VecLen(toks) as u64);
        Lex(f as u32, toks, core);
    }
}

// `envoc1 parse <file.envol>`
void CmdParse(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        Exit(EXIT_USAGE);
    }
    LoadSources(argi, 1);
    Vec toks = VecNew(sizeof(Token), 1024);
    Vec starts = VecNew(8, 4);
    Vec nodes = VecNew(sizeof(Node), 4096);
    unsafe {
        LexAll(&toks, &starts, core);
        u32 program = ParseFiles(&toks, &starts, &nodes, core);
        AstDump(&toks, &nodes, program, 0);
    }
    Exit(EXIT_OK);
}

// `envoc1 check <file.envol>...`: names and types; prints the typed syntax tree.
void CmdCheck(usize argi, bool core) {
    if (argc() <= argi) {
        Usage(2);
        Exit(EXIT_USAGE);
    }
    LoadSources(argi, argc() - argi);
    u32 prelude = 0xFFFFFFFF;
    if (!core) prelude = SrcAdd("<prelude>/prelude.envol", RUNTIME_3);
    Vec toks = VecNew(sizeof(Token), 1024);
    Vec starts = VecNew(8, 4);
    Vec nodes = VecNew(sizeof(Node), 4096);
    unsafe {
        LexAll(&toks, &starts, core);
        u32 program = ParseFiles(&toks, &starts, &nodes, core);
        usize count = VecLen(&nodes);
        Checker c = NewChecker(&toks, &nodes, core, false);
        c.PreludeFile = prelude;
        CheckProgram(&c, program);
        CheckDump(&c, program, 0);
    }
    Exit(EXIT_OK);
}

// `envoc1 eir-check <file.eir>`: reads and verifies EIR text, then prints it in canonical
// form ([eir.text.4]).
void CmdEirCheck(usize argi) {
    if (argc() != argi + 1) {
        Usage(2);
        Exit(EXIT_USAGE);
    }
    LoadSources(argi, 1);
    Module m;
    unsafe {
        ModuleInit(&m);
        ReadEir(0, &m);
        VerifyModule(&m);
        PrintModule(&m, Out());
    }
    Exit(EXIT_OK);
}

// `envoc1 embed <file>...`: prints an Envo-Core source file that holds each file's text as
// a string constant (RUNTIME_0, RUNTIME_1, …). bootstrap/stage1/runtime/embedded.envol is
// made this way from the runtime sources, and the bootstrap tests check it is current.
void CmdEmbed(usize argi) {
    usize count = argc() - argi;
    LoadSources(argi, count);
    *Buf o = Out();
    BufStr(o, "// Generated by `envoc1 embed` from the files named below. Do not edit; regenerate.\n");
    for (usize i = 0; i < count; i++) {
        SrcFile f = SrcGet(i as u32);
        BufStr(o, "\n// ");
        BufStr(o, f.Path);
        BufStr(o, "\nconst str RUNTIME_");
        BufU64(o, i as u64);
        BufStr(o, " = \"");
        for (usize k = 0; k < f.Text.Len; k++) {
            u8 c = f.Text[k];
            if (c == 10) BufStr(o, "\\n");
            else if (c == 13) BufStr(o, "\\r");
            else if (c == 9) BufStr(o, "\\t");
            else if (c == '"') BufStr(o, "\\\"");
            else if (c == 0x5C) BufStr(o, "\\\\");
            else BufByte(o, c);
            if (BufLen(o) >= 1 << 16) Flush();
        }
        BufStr(o, "\";\n");
    }
    Exit(EXIT_OK);
}

// A checker over the parsed program in toks / nodes.
Checker NewChecker(*Vec toks, *Vec nodes, bool core, bool runtime) {
    Checker c;
    usize count = VecLen(nodes);
    c.Toks = toks;
    c.Nodes = nodes;
    c.Core = core;
    c.Runtime = runtime;
    c.NType = SideTable(4, count);
    c.NValue = SideTable(8, count);
    c.NSym = SideTable(4, count);
    c.NMatched = SideTable(1, count);
    c.NMove = SideTable(1, count);
    c.NConv = SideTable(1, count);
    c.Types = VecNew(sizeof(Type), 256);
    c.Syms = VecNew(sizeof(Sym), 1024);
    c.Global = MapNew(1024);
    c.Derived = MapNew(256);
    c.Locals = VecNew(4, 256);
    c.ParamTypes = VecNew(4, 1024);
    c.TypeArgs = VecNew(4, 256);
    c.Instances = MapNew(64);
    c.Methods = MapNew(256);
    c.Impls = VecNew(sizeof(ImplRec), 32);
    c.Bounds = VecNew(4, 64);
    c.Calls = VecNew(4, 1024);
    c.MainCalls = VecNew(4, 64);
    c.Insts = VecNew(sizeof(Inst), 256);
    c.InstMap = MapNew(256);
    c.LamStack = VecNew(4, 24);
    c.CapTmp = VecNew(4, 32);
    c.Captures = VecNew(4, 64);
    c.PreludeFile = 0xFFFFFFFF;
    c.PreludeScope = MapNew(32);
    c.FileNs = VecNew(sizeof(str), 8);
    c.NsSet = MapNew(16);
    c.Uses = VecNew(4, 8);
    c.TokSym = MapNew(16);
    c.Summaries = MapNew(64);
    unsafe { VecPush(&c.TypeArgs); }      // index 0: "no environment"
    return c;
}

void BuildUsage() {
    write(2, "usage: envoc1 build <file.envol>... -o <output> [--target x86_64-windows|x86_64-linux]\n");
    Exit(EXIT_USAGE);
}

// Compiles the program in the files at the given argument indexes, with the runtime for
// target, to a verified EIR module.
void CompileProgram(*Vec fileArgs, u32 target, bool core, *Module m, bool verify) {
    for (usize i = 0; i < VecLen(fileArgs); i++) LoadSources(VecGetU64(fileArgs, i) as usize, 1);
    SrcAdd("<runtime>/common.envol", RUNTIME_0);
    if (target == TARGET_WINDOWS) SrcAdd("<runtime>/windows.envol", RUNTIME_2);
    else SrcAdd("<runtime>/linux.envol", RUNTIME_1);
    u32 prelude = 0xFFFFFFFF;
    if (!core) prelude = SrcAdd("<prelude>/prelude.envol", RUNTIME_3);
    Vec toks = VecNew(sizeof(Token), 1024);
    Vec starts = VecNew(8, 4);
    Vec nodes = VecNew(sizeof(Node), 4096);
    unsafe {
        LexAll(&toks, &starts, core);
        u32 program = ParseFiles(&toks, &starts, &nodes, core);
        Checker c = NewChecker(&toks, &nodes, core, true);
        c.PreludeFile = prelude;
        CheckProgram(&c, program);
        ModuleInit(m);
        Lower l;
        l.C = &c;
        l.M = m;
        l.Target = target;
        LowerProgram(&l, program);
        if (verify) VerifyModule(m);
    }
}

// Reads `build` and `eir` arguments: files, -o <output>, --target <triple>.
u32 ParseBuildArgs(usize argi, *Vec files, *str output) {
    u32 target = TARGET_LINUX;
    if (StrEq(HostTarget(), "x86_64-windows")) target = TARGET_WINDOWS;
    usize i = argi;
    while (i < argc()) {
        str a = arg(i);
        if (StrEq(a, "-o")) {
            if (i + 1 >= argc()) BuildUsage();
            unsafe { *output = arg(i + 1); }
            i += 2;
        } else if (StrEq(a, "--target")) {
            if (i + 1 >= argc()) BuildUsage();
            str t = arg(i + 1);
            if (StrEq(t, "x86_64-windows")) target = TARGET_WINDOWS;
            else if (StrEq(t, "x86_64-linux")) target = TARGET_LINUX;
            else BuildUsage();
            i += 2;
        } else {
            VecPushU64(files, i as u64);
            i++;
        }
    }
    return target;
}

// `envoc1 build <file.envol>... -o <output> [--target …]`
void CmdBuild(usize argi, bool core) {
    Vec files = VecNew(8, 4);
    str output = "";
    u32 target;
    unsafe {
        target = ParseBuildArgs(argi, &files, &output);
        if (VecLen(&files) == 0 || output.Len == 0) BuildUsage();
    }
    Module m;
    unsafe {
        CompileProgram(&files, target, core, &m, true);
        str image = GenModule(&m, target);
        if (!FileWrite(output, image, true)) {
            *Buf e = Err();
            BufStr(e, "envoc1: error: cannot write '");
            BufStr(e, output);
            BufStr(e, "'\n");
            Exit(EXIT_ERRORS);
        }
    }
    Exit(EXIT_OK);
}

// `envoc1 eir <file.envol>... [--target …]`: the program's EIR, runtime included.
void CmdEir(usize argi, bool core) {
    Vec files = VecNew(8, 4);
    str output = "";
    u32 target;
    unsafe {
        target = ParseBuildArgs(argi, &files, &output);
        if (VecLen(&files) == 0) BuildUsage();
    }
    Module m;
    unsafe {
        CompileProgram(&files, target, core, &m, false);     // eir-check the output to verify it
        PrintModule(&m, Out());
    }
    Exit(EXIT_OK);
}
